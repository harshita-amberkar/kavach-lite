KAVACH_API_TOKEN=REPLACE_WITH_A_RANDOM_TOKEN_OF_AT_LEAST_40_CHARACTERS
KAVACH_DB_PATH=data/kavach.db
# Workflow audit retention in days; 0 disables cleanup. SQLite is not encrypted by default.
KAVACH_AUDIT_RETENTION_DAYS=30
KAVACH_ALLOWED_HOSTS=127.0.0.1,localhost
# Per-client request limits within a rolling 60-second window (1–1000).
KAVACH_RATE_LIMIT_SCAN_PER_MINUTE=30
KAVACH_RATE_LIMIT_SCAN_FILE_PER_MINUTE=10
KAVACH_RATE_LIMIT_CHAT_PER_MINUTE=20
# Ollama must use localhost, 127.0.0.1, or [::1]; remote endpoints are rejected.
KAVACH_OLLAMA_URL=http://127.0.0.1:11434/api/generate
