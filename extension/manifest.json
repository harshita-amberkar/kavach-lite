{
  "manifest_version": 3,
  "name": "Kavach",
  "version": "0.1.0",
  "description": "Scans prompt text locally in your browser and offers configurable privacy actions for supported AI chat sites.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*", "https://claude.ai/*", "https://gemini.google.com/*"],
    "js": ["detector.js", "content.js"],
    "run_at": "document_idle"
  }],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
